# 复制为 .env 后按需修改；.env 不要提交

# ---------- 数据库 ----------
POSTGRES_DB=ppl
POSTGRES_USER=ppl
POSTGRES_PASSWORD=change-me-before-deploy

# 宿主机端口（容器内固定 8080）
PPL_PORT=8080

# 只在需要从宿主机连库调试时用到
PPL_DB_PORT=5432

# ---------- 服务端 ----------
# 签发登录 token 用。不配会每次启动随机生成，重启后所有登录失效。
# 生成：openssl rand -hex 32
PPL_JWT_SECRET=change-me-to-a-long-random-string
PPL_JWT_TTL_HOURS=168

# 对外可访问的根地址，用来拼资源下载链接。
# 反代之后要写成 https://你的域名，否则客户端拿到的是内网地址。
PPL_PUBLIC_BASE=https://ziyuan.pixelpine.org

# 资源包落盘目录（容器内路径，对应 compose 的 ppl-files 卷）
PPL_STORAGE_DIR=/data/packages

# 管理员邮箱：后台登录用这个账号
PPL_ADMIN_EMAIL=you@example.com

# ---------- 审核后台密码（不配则后台登录停用） ----------
# 明文或 pbkdf2-sha256:<迭代>:<salt hex>:<hash hex> 都认，后者推荐。
# 生成哈希（把 你的密码 换成实际密码，整条命令照抄）：
#   node -e 'const c=require("crypto"),p=process.argv[1],s=c.randomBytes(16),i=120000;console.log("pbkdf2-sha256:"+i+":"+s.toString("hex")+":"+c.pbkdf2Sync(p,s,i,32,"sha256").toString("hex"))' '你的密码'
PPL_ADMIN_PASSWORD=

# ---------- 邮件（不配则无法注册） ----------
# SMTP 端口 465 是隐式 TLS，587 是 STARTTLS
PPL_SMTP_HOST=smtp.example.com
PPL_SMTP_PORT=465
PPL_SMTP_USER=noreply@example.com
PPL_SMTP_PASS=change-me

# 发件人显示名，格式：名字 <地址>
PPL_SMTP_FROM=PPL 市场 <noreply@example.com>

# ---------- 人机验证（不配则注册不校验） ----------
PPL_GEETEST_ID=
PPL_GEETEST_KEY=

# 开发模式：验证码随接口返回，方便本地联调。
# 生产必须留空或设为 0，否则任何人都能直接登录任意邮箱。
PPL_DEV_MODE=0

# 日志级别
RUST_LOG=info,tower_http=warn
