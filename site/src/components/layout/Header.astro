---
/**
 * 站点页头：品牌、导航、主题切换、下载入口。
 * 移动端用 <details> 做折叠菜单——不需要 JS，也就不会有「脚本没加载导致点不开」。
 */
import ThemeToggle from '../ui/ThemeToggle.astro';
import { SITE, url } from '../../lib/site';

const path = Astro.url.pathname;

const nav = [
  { label: '功能', href: url('/#features') },
  { label: '界面', href: url('/#screens') },
  { label: '下载', href: url('/#download') },
  { label: '常见问题', href: url('/#faq') },
  { label: '关于', href: url('/about') },
];

const isActive = (href: string) =>
  !href.includes('#') && path.replace(/\/$/, '') === href.replace(/\/$/, '');
---

<header class="glass-nav sticky top-0 z-50 w-full">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 md:px-6">
    <a href={url('/')} class="flex items-center gap-2.5" aria-label={`${SITE.name} 首页`}>
      <img src={url('/logo.png')} alt="" width="28" height="28" class="rounded-lg" />
      <span class="font-display text-[15px] font-semibold tracking-tight">
        Pixel-Pine{' '}
        <span class="text-[var(--color-primary-500)] dark:text-[var(--color-primary-400)]"
          >Launcher</span
        >
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="主导航">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-lg px-3 py-2 text-sm transition-colors',
              isActive(item.href)
                ? 'text-[var(--text-primary)] font-medium'
                : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)]',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />

      <a
        href={SITE.releases}
        target="_blank"
        rel="noreferrer"
        class="hidden items-center gap-1.5 rounded-lg bg-[var(--color-primary-600)] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[var(--color-primary-700)] sm:inline-flex"
      >
        下载
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-3.5 w-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" />
        </svg>
      </a>

      <details class="relative md:hidden">
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-lg border border-[var(--border)] text-[var(--text-secondary)] [&::-webkit-details-marker]:hidden"
          aria-label="菜单"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4.5 w-4.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </summary>
        <div
          class="absolute right-0 mt-2 w-44 overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--bg)] p-1 shadow-xl"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="block rounded-lg px-3 py-2 text-sm text-[var(--text-secondary)] hover:bg-[var(--bg-secondary)] hover:text-[var(--text-primary)]"
              >
                {item.label}
              </a>
            ))
          }
          <a
            href={SITE.releases}
            target="_blank"
            rel="noreferrer"
            class="mt-1 block rounded-lg bg-[var(--color-primary-600)] px-3 py-2 text-center text-sm font-semibold text-white"
          >
            下载安装包
          </a>
        </div>
      </details>
    </div>
  </div>
</header>
