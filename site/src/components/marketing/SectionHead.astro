---
/**
 * 区块标题：符号 + 大标题 + 一句说明，默认居中。
 * 参考站用 ✦ ● ◆ 这类符号给长页面分段，比纯标题更有节奏。
 */
interface Props {
  glyph: string;
  title: string;
  lead?: string;
  align?: 'center' | 'left';
  id?: string;
}

const { glyph, title, lead, align = 'center', id } = Astro.props;
---

<div class:list={['section-head', align === 'left' ? 'is-left' : 'is-center']}>
  <span class="section-glyph" aria-hidden="true">{glyph}</span>
  <h2 id={id} class="section-title">{title}</h2>
  {lead && <p class="section-lead">{lead}</p>}
</div>
