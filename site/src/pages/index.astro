---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import HeroStage from '../components/marketing/HeroStage.astro';
import SectionHead from '../components/marketing/SectionHead.astro';
import BentoGrid from '../components/marketing/BentoGrid.astro';
import FaqAccordion from '../components/marketing/FaqAccordion.astro';
import { SITE, PLATFORMS, url, absoluteUrl } from '../lib/site';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.name,
  applicationCategory: 'GameApplication',
  operatingSystem: 'Windows, Linux, macOS',
  description: SITE.description,
  url: absoluteUrl('/'),
  downloadUrl: SITE.releases,
  softwareVersion: SITE.version,
  license: SITE.license,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'CNY',
  },
  author: {
    '@type': 'Organization',
    name: 'CloudRail BBS',
    url: SITE.repo,
  },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: absoluteUrl('/'),
  description: SITE.description,
  inLanguage: 'zh-CN',
};
---

<BaseLayout
  title={SITE.name}
  description={SITE.description}
  image="/og.png"
  appendSiteName={false}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </Fragment>

  <Header slot="header" />

  <HeroStage
    ghost="PIXEL PINE"
    kicker={`预览版 v${SITE.version} · Windows / Linux / macOS`}
    titleTop="把战场"
    titleBottom="收进一个窗口"
    subtitle="游戏下载、实例、Mod 预设、地图、联机与资源市场，收进一个窗口。"
    primary={{
      text: '下载安装包',
      href: SITE.releases,
      external: true,
      label: '前往 GitHub Releases 下载安装包',
    }}
    secondary={{
      text: '查看源码',
      href: SITE.repo,
      external: true,
      label: '在 GitHub 查看源码仓库',
    }}
    links={[
      { text: '阅读文档', href: url('/docs') },
      { text: '扩展规范', href: url('/docs/pplx') },
    ]}
  />

  <!-- ── 界面 ────────────────────────────────────────────── -->
  <section id="screens" class="scroll-mt-24 px-6 py-16 md:py-24">
    <div class="mx-auto max-w-6xl">
      <SectionHead
        glyph="✦"
        title="先看界面"
        lead="左边是实例与预设，右边是当前的 Mod 列表。装完就在这儿，不用再翻文件夹。"
      />

      <figure class="media glass overflow-hidden rounded-2xl">
        <img
          src={url('/screenshots/library.webp')}
          alt="库页：左侧是实例与预设，右侧是已安装的 Mod 列表，每行显示版本与启用开关"
          width="1440"
          height="900"
          class="block h-auto w-full"
          data-fade
          loading="eager"
          fetchpriority="high"
        />
      </figure>

      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <figure class="media glass overflow-hidden rounded-2xl">
          <img
            src={url('/screenshots/market.webp')}
            alt="市场页：资源卡片列表，支持按类型筛选与关键词搜索"
            width="1440"
            height="900"
            class="block h-auto w-full"
            data-fade
            loading="lazy"
          />
        </figure>

        <div class="glass flex flex-col justify-center rounded-2xl p-8">
          <h2 class="font-display text-xl font-semibold">先说清楚它管什么</h2>
          <ul class="mt-5 space-y-4 text-sm leading-relaxed text-[var(--text-secondary)]">
            <li>
              <span class="font-medium text-[var(--text-primary)]">预设切换</span>
              —— 一次点击重建链接，Mod 文件一个字节都不动。
            </li>
            <li>
              <span class="font-medium text-[var(--text-primary)]">冲突可见</span>
              —— 同名单位互相覆盖时，扫描阶段就标出冲突双方。
            </li>
            <li>
              <span class="font-medium text-[var(--text-primary)]">装完即用</span>
              —— 市场安装的资源直接落到当前预设，不用再手动解压。
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 三步开始 ────────────────────────────────────────── -->
  <section class="px-6 py-14 md:py-20">
    <div class="mx-auto max-w-5xl">
      <SectionHead glyph="◈" title="三步开始" lead="不用读文档也能装上：下载、指一下游戏、挑个预设。" />

      <ol class="grid gap-4 sm:grid-cols-3">
        {
          [
            { step: '01', title: '装好启动器', desc: '从 Release 下载对应平台的安装包，装到当前用户目录即可。' },
            { step: '02', title: '指一下游戏', desc: '已装过就选目录，没有就下载一份——不碰 Steam 的安装。' },
            { step: '03', title: '挑个预设开玩', desc: '切换预设只重建链接，Mod 文件一个字节都不动。' },
          ].map((item) => (
            <li class="rounded-2xl border border-[var(--glass-border)] bg-white/[0.02] p-6">
              <span class="font-mono text-xs text-[var(--color-primary-500)]">{item.step}</span>
              <h3 class="mt-4 font-display text-base font-semibold">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">{item.desc}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <BentoGrid
    glyph="◆"
    title="不是「装游戏」，是管理组合"
    subtitle="铁锈战争只有一个 mods/units 目录，所有 Mod 混在一起。PPL 把每一套玩法做成一个预设。"
    items={[
      {
        title: '一套玩法，一个预设',
        description:
          '游戏目录里的 mods/units 指向当前预设，切换时只重建一次链接——零拷贝、毫秒级，也不污染玩家已有数据。',
        colSpan: 2,
        icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75 2.25 12l4.179 2.25m0-4.5 5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0 4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0-5.571 3-5.571-3"/></svg>',
      },
      {
        title: '冲突提前发现',
        description:
          '两个 Mod 覆盖同一个单位时，扫描阶段就能列出冲突双方和冲突目录，不用等进游戏才发现单位没了。',
        icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/></svg>',
      },
      {
        title: '内置资源市场',
        description: '搜索、详情、版本历史、举报都在同一个界面里；上传要过邮箱验证与人工审核。',
        icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72M6.75 18h3.75a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75H6.75a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75Z"/></svg>',
      },
      {
        title: '三个平台',
        description:
          'Windows 用 NTFS 目录联接，不需要管理员权限；macOS 与 Linux 用符号链接。',
        icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25"/></svg>',
      },
      {
        title: '自动更新',
        description: '启动时读取更新清单，有新版在顶部提示；三平台共用一份签名，不用手动找安装包。',
        icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"/></svg>',
      },
      {
        title: '地图与联机',
        description:
          '地图库按尺寸和人数筛选；联机页读取房间快照，开服前就知道有没有人。',
        colSpan: 2,
        icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0Z"/></svg>',
      },
      {
        title: '扩展加载器',
        description:
          'ppl-extension.json 描述依赖与加载顺序，按拓扑排序决定先后，成环的整组跳过而不是随机崩。',
        icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875s-2.25.84-2.25 1.875c0 .369.128.713.349 1.003.215.283.401.604.401.959v0a.64.64 0 0 1-.657.643 48.39 48.39 0 0 1-4.163-.3c.186 1.613.293 3.25.315 4.907a.656.656 0 0 1-.658.663v0c-.355 0-.676-.186-.959-.401a1.647 1.647 0 0 0-1.003-.349c-1.036 0-1.875 1.007-1.875 2.25s.84 2.25 1.875 2.25c.369 0 .713-.128 1.003-.349.283-.215.604-.401.959-.401v0c.31 0 .555.26.532.57a48.039 48.039 0 0 1-.642 5.056c1.518.19 3.058.309 4.616.354a.64.64 0 0 0 .657-.643v0c0-.355-.186-.676-.401-.959a1.647 1.647 0 0 1-.349-1.003c0-1.035 1.008-1.875 2.25-1.875 1.243 0 2.25.84 2.25 1.875 0 .369-.128.713-.349 1.003-.215.283-.4.604-.4.959v0c0 .333.277.599.61.58a48.1 48.1 0 0 0 5.427-.63 48.05 48.05 0 0 0 .582-4.717.532.532 0 0 0-.533-.57v0c-.355 0-.676.186-.959.401-.29.221-.634.349-1.003.349-1.035 0-1.875-1.007-1.875-2.25s.84-2.25 1.875-2.25c.37 0 .713.128 1.003.349.283.215.604.401.96.401v0a.656.656 0 0 0 .658-.663 48.422 48.422 0 0 0-.37-5.36c-1.886.342-3.81.574-5.766.689a.578.578 0 0 1-.61-.58v0Z"/></svg>',
      },
    ]}
  />

  <!-- ── 下载 ────────────────────────────────────────────── -->
  <section
    id="download"
    class="scroll-mt-24 py-20 md:py-28"
  >
    <div class="mx-auto max-w-6xl px-6">
      <SectionHead
        glyph="◇"
        title="下载 Pixel-Pine-Launcher"
        lead="预览版：功能可用，但请当作测试版看待。安装包由 CI 在打版本标签时构建，三平台共用同一份更新签名。"
      />

      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {
          PLATFORMS.map((platform) => (
            <article class="glass flex flex-col rounded-2xl p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-[var(--color-primary-500)]/60">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="flex items-center gap-2 font-display text-lg font-semibold">
                  {platform.name}
                  {platform.recommended && (
                    <span class="rounded-full border border-[var(--color-primary-500)]/40 bg-[var(--color-primary-500)]/10 px-2 py-0.5 text-[10px] font-medium text-[var(--color-primary-500)]">
                      推荐
                    </span>
                  )}
                </h3>
                <span class="font-mono text-xs text-[var(--text-secondary)]">{platform.arch}</span>
              </div>

              <p class="mt-3 flex-1 text-sm leading-relaxed text-[var(--text-secondary)]">
                {platform.note}
              </p>

              <p class="mt-4 font-mono text-xs text-[var(--text-secondary)] opacity-80">
                v{SITE.version} · 由 CI 构建
              </p>

              <a
                href={SITE.releases}
                target="_blank"
                rel="noreferrer"
                class:list={[
                  'pill mt-5 w-full',
                  platform.recommended ? 'pill-solid' : 'pill-outline',
                ]}
              >
                {platform.action}
              </a>
            </article>
          ))
        }
      </div>

      <p class="mt-8 text-center text-sm leading-relaxed text-[var(--text-secondary)]">
        也可以到 <a
          href={SITE.releases}
          target="_blank"
          rel="noreferrer"
          class="text-[var(--text-primary)] underline decoration-[var(--border)] underline-offset-4 hover:decoration-[var(--color-primary-500)]"
          >全部版本</a
        > 里挑，或从 <a
          href={SITE.repo}
          target="_blank"
          rel="noreferrer"
          class="text-[var(--text-primary)] underline decoration-[var(--border)] underline-offset-4 hover:decoration-[var(--color-primary-500)]"
          >源码</a
        > 自行编译。需要自备正版游戏，PPL 不包含游戏本体。
      </p>
    </div>
  </section>

  <FaqAccordion
    glyph="●"
    title="常见问题"
    description="关于授权、数据与平台的几个高频疑问。"
    faqs={[
      {
        question: '这是官方启动器吗？',
        answer:
          '不是。PPL 是第三方开源项目，与 Corroding Games 及《铁锈战争》开发团队没有隶属或合作关系，也不代表其立场。',
      },
      {
        question: '需要先买正版游戏吗？',
        answer:
          '需要。PPL 不包含、也不分发游戏本体，只负责管理你已经安装的游戏，或在有授权的前提下提供下载入口。',
      },
      {
        question: '会修改我的游戏目录吗？',
        answer:
          '只会重建 mods/units 这一个链接，其他文件不动。已有安装目录默认只读；卸载启动器不会删除你的 Mod 与存档，数据都在 PPL 自己的存储区。',
      },
      {
        question: '支持哪些平台？',
        answer:
          'Windows x64、Linux x64，以及 macOS（Apple 芯片与 Intel 各一个安装包）。macOS 包没有代码签名，首次打开需要右键「打开」。',
      },
      {
        question: '怎么更新？',
        answer:
          '客户端内置自更新：启动时读取更新清单，有新版会在界面上方提示。安装包由 CI 在打 vX.Y.Z 标签时构建，签名与客户端内置公钥一致。',
      },
      {
        question: '市场里的内容谁审核？',
        answer:
          '用户上传、运营审核。上传需要邮箱验证并通过人工审核才会公开。发现侵权或有害内容，可以在客户端内直接举报。',
      },
    ]}
  />

  <!-- ── 收尾 CTA ────────────────────────────────────────── -->
  <section class="px-6 py-20 md:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-[clamp(28px,4.4vw,46px)] font-bold leading-[1.15] tracking-tight">
        换个玩法，<br class="sm:hidden" />不该是搬一次文件
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-[15.5px] leading-relaxed text-[var(--text-secondary)]">
        下载后先指一下你已经装好的游戏，剩下的交给预设。
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={SITE.releases}
          target="_blank"
          rel="noreferrer"
          class="pill pill-solid"
        >
          下载安装包
        </a>
        <a
          href={SITE.repo}
          target="_blank"
          rel="noreferrer"
          class="pill pill-outline"
        >
          先看源码
        </a>
      </div>
      <p class="mt-6 text-xs text-[var(--text-secondary)] opacity-80">
        MIT 开源 · 不改游戏目录 · 卸载不删 Mod 与存档
      </p>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
