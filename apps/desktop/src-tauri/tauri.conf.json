{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixel-Pine-Launcher",
  "version": "0.1.1",
  "identifier": "com.cloudrail.pixelpine",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pixel-Pine-Launcher",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#0E1013"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "CloudRail BBS",
    "copyright": "Copyright © 2026 CloudRail BBS",
    "shortDescription": "《铁锈战争》启动器",
    "longDescription": "把游戏实例、Mod 组合、地图库、联机与资源市场收进一个窗口。",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://ziyuan.pixelpine.org/v1/launcher/latest.json",
        "https://github.com/CloudRail-BBS/Pixel-Pine-Launcher/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDNTQzMTQ1NDgxNDlGNDUKUldSRm54UklSVEZVZkJ4cm9KcXVSQzU4OFJ4a010ZDIzUm1yeFh3akxFSkIzSEFUSGtkeUlRdXAK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
